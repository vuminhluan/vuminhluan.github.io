- const mNames = [t('sims.meeting.ui.you'), 'David', 'Leo', 'Ann']
- const mTileBg = ['from-sky-700 to-slate-800', 'from-violet-700 to-slate-800', 'from-emerald-700 to-slate-800', 'from-rose-700 to-slate-800']

article#sim-meeting(data-sim="meeting", data-surface="lobby", data-rail="closed", data-tab="chat")
  header(class="mb-4 flex flex-wrap items-baseline gap-x-3 gap-y-1")
    h3(class="text-xl font-extrabold tracking-tight text-resume-ink")= t('sims.meeting.name')
    span(class="text-sm text-resume-muted")= t('sims.meeting.productType')
    span(class="rounded-full border border-resume-line bg-white px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider text-resume-muted")= t('sims.common.simTag')
  div(class="grid")
    div(class="min-w-0")
      div(class="sim-frame overflow-hidden rounded-xl border border-resume-line bg-white shadow-lg")
        +simChrome('meet.example.app/' + sims.meeting.roomCode)
        div(class="sim-app relative h-[440px] text-[13px] sm:h-[480px]")
          //- LOBBY (light surface)
          div.m-lobby(class="h-full flex-col items-center justify-center gap-6 bg-white px-6 py-4 sm:flex-row sm:gap-10")
            div(class="w-full max-w-none sm:max-w-[270px]")
              div(class="flex h-40 flex-col items-center justify-center gap-2 rounded-xl bg-slate-900 text-slate-300 sm:h-44")
                svg(viewBox="0 0 24 24", width="26", height="26", fill="none", stroke="currentColor", stroke-width="1.5", aria-hidden="true")
                  path(d="M3.5 7.5h9a1.5 1.5 0 0 1 1.5 1.5v6a1.5 1.5 0 0 1-1.5 1.5h-9A1.5 1.5 0 0 1 2 15V9a1.5 1.5 0 0 1 1.5-1.5Z")
                  path(d="m14 10.5 5-2.5v8l-5-2.5")
                  path(d="M3 3l18 18", stroke="#f87171")
                span(class="text-xs font-semibold")= t('sims.meeting.ui.cameraOff')
            div(class="max-w-[250px] text-center sm:text-left")
              h4(class="text-lg font-extrabold text-resume-ink")= t('sims.meeting.ui.lobbyTitle')
              p(class="mt-1.5 text-xs leading-snug text-resume-muted")= t('sims.meeting.ui.aiHint')
              div(class="mt-4 flex items-center justify-center gap-2 sm:justify-start")
                button.m-devbtn(type="button", data-m="cam", aria-pressed="false", aria-label=t('sims.meeting.ui.camBtn'))
                  svg(viewBox="0 0 16 16", width="14", height="14", fill="none", stroke="currentColor", stroke-width="1.3", aria-hidden="true")
                    rect(x="1.5", y="4.5", width="8", height="7", rx="1.5")
                    path(d="m9.5 7 5-2.5v7L9.5 9")
                    line.m-slash(x1="2", y1="2", x2="14", y2="14", stroke-width="1.5")
                button.m-devbtn(type="button", data-m="mic", aria-pressed="false", aria-label=t('sims.meeting.ui.micBtn'))
                  svg(viewBox="0 0 16 16", width="14", height="14", fill="none", stroke="currentColor", stroke-width="1.3", aria-hidden="true")
                    rect(x="6", y="1.5", width="4", height="8", rx="2")
                    path(d="M3.5 7.5a4.5 4.5 0 0 0 9 0M8 12v2.5")
                    line.m-slash(x1="2", y1="2", x2="14", y2="14", stroke-width="1.5")
                button(type="button", data-m="join", class="rounded-full bg-blue-600 px-5 py-2 text-xs font-bold uppercase tracking-wide text-white shadow-md transition hover:bg-blue-500")= t('sims.meeting.ui.joinBtn')
          //- ROOM (dark surface)
          div.m-room(class="h-full flex-col bg-[#0e1013] text-slate-100")
            svg(class="m-corner pointer-events-none absolute left-2 top-2 opacity-40", viewBox="0 0 24 24", width="20", height="20", fill="none", stroke="#38bdf8", stroke-width="2", aria-hidden="true")
              path(d="M2 10V2h8")
            svg(class="m-corner pointer-events-none absolute right-2 top-2 opacity-40", viewBox="0 0 24 24", width="20", height="20", fill="none", stroke="#38bdf8", stroke-width="2", aria-hidden="true")
              path(d="M14 2h8v8")
            div(class="flex min-h-0 flex-1")
              div(class="flex min-w-0 flex-1 flex-col")
                div.m-grid(data-m="grid", data-count="1", class="grid min-h-0 flex-1 gap-2 p-3")
                  each name, i in mNames
                    div.m-tile(data-tile=i, class=`relative flex items-center justify-center overflow-hidden rounded-lg bg-gradient-to-br ${mTileBg[i]}`)
                      span(class="flex h-12 w-12 items-center justify-center rounded-full bg-white/15 text-lg font-extrabold text-white")= name.charAt(0)
                      span(class="absolute bottom-1.5 left-2 rounded bg-black/45 px-1.5 py-0.5 text-[10px] font-semibold")= name
                      span(class="absolute bottom-1.5 right-2 text-slate-300")
                        svg(viewBox="0 0 16 16", width="10", height="10", fill="none", stroke="currentColor", stroke-width="1.3", aria-hidden="true")
                          rect(x="6", y="1.5", width="4", height="8", rx="2")
                          path(d="M3.5 7.5a4.5 4.5 0 0 0 9 0M8 12v2.5")
                  div.m-more(class="hidden items-center justify-center rounded-lg bg-white/5 text-sm font-bold text-slate-300") +2
                div.m-caption(data-m="caption", hidden, class="mx-3 mb-2 flex items-baseline gap-2 rounded-lg bg-black/60 px-3 py-2 backdrop-blur")
                  span.m-cap-speaker(class="shrink-0 text-[11px] font-bold text-sky-300")
                  span.m-cap-marker(class="shrink-0 rounded bg-sky-500/20 px-1 py-px text-[9px] font-bold uppercase tracking-wide text-sky-300", hidden)
                  span.m-cap-text(class="min-w-0 text-xs leading-snug text-slate-100")
              //- Right rail
              aside.m-rail(class="w-60 shrink-0 flex-col border-l border-white/10 bg-[#15181d]")
                div(class="flex border-b border-white/10 text-[11px] font-semibold")
                  button.m-tab(type="button", data-mtab="chat")= t('sims.meeting.ui.tabChat')
                  button.m-tab(type="button", data-mtab="people")= t('sims.meeting.ui.tabPeople')
                  button.m-tab(type="button", data-mtab="summary")= t('sims.meeting.ui.tabSummary')
                div(class="min-h-0 flex-1 overflow-y-auto p-3 text-xs")
                  div.m-panel(data-panel="chat")
                    div(data-m="chatmsg")
                      div(class="flex items-start gap-2")
                        span(class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-rose-600 text-[10px] font-bold text-white") A
                        div
                          p(class="text-[10px] font-bold text-slate-400") Ann
                          p(class="mt-0.5 rounded-lg rounded-tl-sm bg-white/10 px-2.5 py-1.5 leading-snug text-slate-100")= t('sims.meeting.ui.chatMessage')
                  div.m-panel(data-panel="people", hidden)
                    ul(class="space-y-1.5")
                      each name, i in mNames
                        li(class="flex items-center gap-2 rounded-md bg-white/5 px-2 py-1.5")
                          span(class=`flex h-5 w-5 items-center justify-center rounded-full bg-gradient-to-br ${mTileBg[i]} text-[9px] font-bold text-white`)= name.charAt(0)
                          span(class="font-semibold text-slate-200")= name
                  div.m-panel(data-panel="summary", hidden)
                    button(type="button", data-m="summarize", class="w-full rounded-lg bg-sky-500 px-3 py-2 text-[11px] font-bold uppercase tracking-wide text-white transition hover:bg-sky-400")= t('sims.meeting.ui.summarizeBtn')
                    div(data-m="sumwrap", hidden, class="mt-3")
                      p(class="text-[10px] font-bold uppercase tracking-wider text-sky-300")= t('sims.meeting.ui.summaryTitle')
                      ul(class="mt-1.5 space-y-1.5")
                        each bullet, i in tl('sims.meeting.ui.summaryBullets')
                          li(data-sum=i, hidden, class="flex gap-1.5 leading-snug text-slate-200")
                            span(class="text-sky-400") •
                            span.m-sum-text= bullet
                      p(data-m="note", hidden, class="mt-3 border-t border-white/10 pt-2 text-[10px] italic leading-snug text-slate-500")= t('sims.meeting.ui.dataNote')
                div(data-m="chat-input", class="border-t border-white/10 p-2")
                  div(class="rounded-full border border-white/15 bg-black/20 px-3 py-1.5 text-[11px] text-slate-500")= t('sims.meeting.ui.chatPlaceholder')
            //- Toolbar
            div(class="flex items-center gap-2 border-t border-white/10 px-3 py-2")
              div(class="hidden items-center gap-2 text-[10px] font-semibold text-slate-400 sm:flex")
                span(data-m="timer") 00:00
                span(class="text-slate-600") ·
                span= sims.meeting.roomCode
              div(class="mx-auto flex items-center gap-1.5")
                button.m-toolbtn(type="button", data-m="room-mic", aria-pressed="true", aria-label=t('sims.meeting.ui.micBtn'))
                  svg(viewBox="0 0 16 16", width="13", height="13", fill="none", stroke="currentColor", stroke-width="1.3", aria-hidden="true")
                    rect(x="6", y="1.5", width="4", height="8", rx="2")
                    path(d="M3.5 7.5a4.5 4.5 0 0 0 9 0M8 12v2.5")
                    line.m-slash(x1="2", y1="2", x2="14", y2="14", stroke-width="1.5")
                button.m-toolbtn(type="button", data-m="room-cam", aria-pressed="false", aria-label=t('sims.meeting.ui.camBtn'))
                  svg(viewBox="0 0 16 16", width="13", height="13", fill="none", stroke="currentColor", stroke-width="1.3", aria-hidden="true")
                    rect(x="1.5", y="4.5", width="8", height="7", rx="1.5")
                    path(d="m9.5 7 5-2.5v7L9.5 9")
                    line.m-slash(x1="2", y1="2", x2="14", y2="14", stroke-width="1.5")
                button.m-toolbtn(type="button", data-m="translate", aria-pressed="false", aria-label=t('sims.meeting.ui.translateBtn'))
                  svg(viewBox="0 0 16 16", width="13", height="13", fill="none", stroke="currentColor", stroke-width="1.3", aria-hidden="true")
                    circle(cx="8", cy="8", r="6")
                    path(d="M2 8h12M8 2c-3.5 3.8-3.5 8.2 0 12M8 2c3.5 3.8 3.5 8.2 0 12")
                button.m-toolbtn.m-toolbtn-danger(type="button", data-m="end-call", aria-label=t('sims.meeting.ui.leaveBtn'))
                  svg(viewBox="0 0 16 16", width="13", height="13", fill="none", stroke="currentColor", stroke-width="1.5", aria-hidden="true")
                    path(d="M2 10.5c4-3.5 8-3.5 12 0l-1.8 2.3c-.4.5-1.1.6-1.7.3l-1.6-.9a1.3 1.3 0 0 1-.65-1.4l.15-.8h-2.8l.15.8c.1.55-.16 1.1-.65 1.4l-1.6.9c-.6.3-1.3.2-1.7-.3L2 10.5Z")
              div(class="flex items-center gap-1.5")
                button.m-toolbtn(type="button", data-open-tab="chat", aria-label=t('sims.meeting.ui.tabChat'))
                  svg(viewBox="0 0 16 16", width="13", height="13", fill="none", stroke="currentColor", stroke-width="1.3", aria-hidden="true")
                    path(d="M3 3h10a1 1 0 0 1 1 1v6a1 1 0 0 1-1 1H8l-3 3v-3H3a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1Z")
                button.m-toolbtn(type="button", data-open-tab="people", aria-label=t('sims.meeting.ui.tabPeople'), class="hidden sm:inline-flex")
                  svg(viewBox="0 0 16 16", width="13", height="13", fill="none", stroke="currentColor", stroke-width="1.3", aria-hidden="true")
                    circle(cx="5.5", cy="5.5", r="2.5")
                    path(d="M1.5 13.5c.5-2.5 2-3.8 4-3.8s3.5 1.3 4 3.8M10.5 6a2 2 0 1 0 .01-4M11 9.9c1.8.2 3 1.4 3.4 3.6")
                button.m-toolbtn(type="button", data-open-tab="summary", aria-label=t('sims.meeting.ui.tabSummary'))
                  svg(viewBox="0 0 16 16", width="13", height="13", fill="none", stroke="currentColor", stroke-width="1.3", aria-hidden="true")
                    rect(x="3", y="1.5", width="10", height="13", rx="1.5")
                    path(d="M5.5 5h5M5.5 8h5M5.5 11h3")
          //- Dialogue data (never displayed) — feeds the live-caption cycle
          div(hidden)
            each d in sims.meeting.dialogue
              span(data-mline, data-tile=d.tile, data-speaker=mNames[d.tile], data-from=t(`sims.meeting.ui.dialogue.${d.line}.from`))= t(`sims.meeting.ui.dialogue.${d.line}.text`)
    +simAside('meeting')
