.full-sidebar.active
  span.sidebar-toggle.js-sidebar-toggle
    span.bar
    span.bar
    span.bar
  .sidebar-container
    .me
      .avatar
        a.avatar-link(href="/")
          img(src=profile.avatar, alt=profile.name)
      .name-n-career
        span.name= profile.name
        span.career= t('identity.career')
        span.birthday= profile.birthday
      .goal.me-block
        .title= t('objective.title')
        .content
          p= t('objective.paragraphOne')
          p= t('objective.paragraphTwo')
      .contact.me-block
        .title= t('contact.title')
        .content
          p
            i.mdi.mdi-phone.icon
            = profile.phone
          p
            i.mdi.mdi-email.icon
            = profile.email
          p
            i.mdi.mdi-web.icon
            = profile.website
          p
            i.mdi.mdi-map-marker.icon
            = t('contact.address')
