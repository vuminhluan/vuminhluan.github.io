nav.language-switcher(aria-label=t('languageSwitcher.label'), class="flex items-center gap-1 text-xs font-semibold uppercase tracking-wide text-resume-muted print:hidden")
  a(href="/", aria-current=locale === 'vi' ? 'page' : false, class=`rounded px-1.5 py-0.5 hover:text-resume-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-resume-ink ${locale === 'vi' ? 'text-resume-ink underline underline-offset-4' : ''}`) VI
  span(aria-hidden="true") /
  a(href="/en.html", aria-current=locale === 'en' ? 'page' : false, class=`rounded px-1.5 py-0.5 hover:text-resume-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-resume-ink ${locale === 'en' ? 'text-resume-ink underline underline-offset-4' : ''}`) EN
