//- Shared building blocks for UI simulations.

mixin simChrome(url)
  div(class="flex items-center gap-2 border-b border-resume-line bg-[#f6f6f8] px-3 py-2")
    div(class="flex gap-1.5")
      span(class="h-2.5 w-2.5 rounded-full bg-[#dcdce2]")
      span(class="h-2.5 w-2.5 rounded-full bg-[#dcdce2]")
      span(class="h-2.5 w-2.5 rounded-full bg-[#dcdce2]")
    div(class="mx-auto flex min-w-0 items-center gap-1.5 rounded-md border border-resume-line bg-white px-3 py-0.5 text-[11px] text-resume-muted")
      svg(viewBox="0 0 16 16", width="10", height="10", fill="none", stroke="currentColor", stroke-width="1.5", aria-hidden="true")
        rect(x="3", y="7", width="10", height="7", rx="1.5")
        path(d="M5 7V5a3 3 0 0 1 6 0v2")
      span.truncate= url
    div(class="w-10", aria-hidden="true")

//- The status bar shared by the two native-app frames (Haloki, Hahalolo). No
//- bezel, no notch, no home indicator — those read as generated filler. The
//- time is 10:24 rather than Apple's 9:41 for the same reason. Purely
//- decorative, so the whole strip is hidden from assistive tech.
mixin simPhoneStatus()
  div(class="flex h-8 shrink-0 items-center justify-between px-4 text-[11px] font-semibold text-resume-muted", aria-hidden="true")
    span 10:24
    span(class="flex items-center gap-1.5")
      svg(viewBox="0 0 16 10", width="14", height="9", fill="currentColor")
        rect(x="0", y="6", width="2.6", height="4", rx="0.6")
        rect(x="4.2", y="4", width="2.6", height="6", rx="0.6")
        rect(x="8.4", y="2", width="2.6", height="8", rx="0.6")
        rect(x="12.6", y="0", width="2.6", height="10", rx="0.6")
      svg(viewBox="0 0 16 12", width="14", height="10", fill="none", stroke="currentColor", stroke-width="1.3")
        path(d="M1 4.2a10 10 0 0 1 14 0")
        path(d="M3.6 6.9a6.3 6.3 0 0 1 8.8 0")
        circle(cx="8", cy="9.9", r="1.1", fill="currentColor", stroke="none")
      svg(viewBox="0 0 18 10", width="16", height="9", fill="none", stroke="currentColor", stroke-width="1.1")
        rect(x="0.6", y="0.6", width="14", height="8.8", rx="2.2")
        rect(x="2.2", y="2.2", width="9", height="5.6", rx="1.2", fill="currentColor", stroke="none")
        path(d="M16.4 3.6v2.8", stroke-width="2", stroke-linecap="round")

mixin simAside(simKey, extraClass)
  aside(class="mt-4 rounded-xl border border-resume-line bg-white p-4 text-sm", class=extraClass)
    dl(class="divide-y divide-resume-line")
      div(class="flex flex-col gap-1 pb-3 sm:flex-row sm:items-baseline sm:gap-4")
        dt(class="w-24 shrink-0 text-[10px] font-bold uppercase tracking-widest text-resume-muted")= t('sims.common.roleLabel')
        dd(class="leading-snug text-resume-ink")= t(`sims.${simKey}.role`)
      div(class="flex flex-col gap-1 py-3 sm:flex-row sm:items-baseline sm:gap-4")
        dt(class="w-24 shrink-0 text-[10px] font-bold uppercase tracking-widest text-resume-muted")= t('sims.common.stackLabel')
        dd(class="leading-snug")= t(`sims.${simKey}.stack`)
      div(class="flex flex-col gap-1 py-3 sm:flex-row sm:items-baseline sm:gap-4")
        dt(class="w-24 shrink-0 text-[10px] font-bold uppercase tracking-widest text-resume-muted")= t('sims.common.scaleLabel')
        dd(class="leading-snug")= t(`sims.${simKey}.scale`)
      div(class="flex flex-col gap-1 pt-3 sm:flex-row sm:items-baseline sm:gap-4")
        dt(class="w-24 shrink-0 text-[10px] font-bold uppercase tracking-widest text-resume-muted")= t('sims.common.outcomeLabel')
        dd(class="leading-snug")= t(`sims.${simKey}.outcome`)
