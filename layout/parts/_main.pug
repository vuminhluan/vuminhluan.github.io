.main-block.education
  .title
    i.main-block-title-icon.mdi.mdi-lightbulb-on
    = t('education.title')
  .content
    ul
      li
        p
          span.item-title= t('education.degree')
          span= `${t('education.school')} (${profile.education.period})`
          br
          span= t('education.major')
          br
          span= `${t('education.grade')} ${profile.education.gpa}`
.main-block.experience
  .title
    i.main-block-title-icon.mdi.mdi-briefcase
    = t('experience.title')
  .content
    ul
      li
        p
          span.item-title= t('experience.signinCompany')
          span= `${t('experience.signinRole')}: ${profile.experience.signinPeriod}`
          br
          span= t('experience.workLabel')
          br
          span= t('experience.signinTaskOne')
          br
          span= t('experience.signinTaskTwo')
      li
        p
          span.item-title= t('experience.angelCompany')
          span= `${t('experience.angelRole')}: ${profile.experience.angelPeriod}`
          br
          span= t('experience.workLabel')
          br
          span= t('experience.angelTaskOne')
          br
          span= t('experience.angelTaskTwo')
.main-block
  .title
    i.main-block-title-icon.mdi.mdi-cogs
    = t('skills.title')
  .content
    ul
      li
        p
          span.item-title= t('skills.specializedTitle')
          span= t('skills.specializedOne')
          br
          span= t('skills.specializedTwo')
      li
        p
          span.item-title= t('skills.languageTitle')
          span= t('skills.languageValue')
      li
        p
          span.item-title= t('skills.softTitle')
          span= t('skills.softValue')
.main-block.experience
  .title
    i.main-block-title-icon.mdi.mdi-run
    = t('activities.title')
  .content
    ul
      li
        p
          span.item-title= t('activities.olympic')
      li
        p
          span.item-title= t('activities.bootcampTitle')
          span= t('activities.bootcampOne')
          br
          span= t('activities.bootcampTwo')
.main-block.experience
  .title
    i.main-block-title-icon.mdi.mdi-thumb-up
    = t('interests.title')
  .content
    ul
      li
        p
          span= t('interests.value')
